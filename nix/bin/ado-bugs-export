#!/usr/bin/env python3
"""Export Azure DevOps Bug work items to CSV (the Reliability data source).

This is the fifth DORA metric's feeder. It exports Bug work items for a project
via the WIQL + work-items REST APIs, so the operational-quality signal that backs
the Reliability metric is reproducible from one command.

It intentionally uses the REST API directly (like the sibling ado-* scripts)
because `az boards query` returns empty results against some org/process
configurations, whereas the REST WIQL endpoint is reliable.

The `ado-dora` wrapper turns the CSV into weekly reliability figures:
  * new-bug rate      - bugs created per week (defect inflow)
  * open backlog      - bugs still open at each week boundary
  * bug recovery time - created -> resolved hours (a labelled restore proxy)

Nothing about a specific organization, project, or area path is baked in; all
targeting is done through runtime flags. Narrow to a product area with
`--area-path`, and (optionally) to a severity with `--severity`.
"""

from __future__ import annotations

import argparse
import base64
import csv
import datetime as dt
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from typing import Any


API_VERSION = "7.1"
ADO_RESOURCE = "499b84ac-1321-427f-aa17-267ca6975798"
# ADO caps a single work-items batch read at 200 ids.
BATCH_SIZE = 200

FIELDS = [
    "System.Id",
    "System.WorkItemType",
    "System.Title",
    "System.State",
    "System.AreaPath",
    "System.Tags",
    "System.CreatedDate",
    "Microsoft.VSTS.Common.ResolvedDate",
    "Microsoft.VSTS.Common.ClosedDate",
    "Microsoft.VSTS.Common.Severity",
    "System.AssignedTo",
]


class AdoRequestError(RuntimeError):
    def __init__(self, status_code: int, reason: str, url: str, body: str) -> None:
        super().__init__(f"ADO request failed: {status_code} {reason}\n{url}\n{body}")
        self.status_code = status_code
        self.reason = reason
        self.url = url
        self.body = body


def default_since() -> str:
    today = dt.date.today()
    return f"{today.year - 1}-10-01"


def parse_date(value: str) -> dt.datetime:
    try:
        return dt.datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=dt.timezone.utc)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("date must use YYYY-MM-DD format") from exc


def parse_ado_datetime(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    normalized = value.replace("Z", "+00:00")
    if "." in normalized:
        prefix, suffix = normalized.split(".", 1)
        timezone_start = min(
            [index for index in (suffix.find("+"), suffix.find("-")) if index != -1]
            or [len(suffix)]
        )
        fraction = suffix[:timezone_start][:6].ljust(6, "0")
        timezone = suffix[timezone_start:]
        normalized = f"{prefix}.{fraction}{timezone}"
    try:
        return dt.datetime.fromisoformat(normalized)
    except ValueError:
        return None


class AzureDevOpsClient:
    def __init__(self, organization: str, project: str, pat: str | None, bearer_token: str | None) -> None:
        self.organization = organization
        self.project = project
        if pat:
            auth_value = f"Basic {base64.b64encode(f':{pat}'.encode('utf-8')).decode('ascii')}"
        elif bearer_token:
            auth_value = f"Bearer {bearer_token}"
        else:
            raise ValueError("Missing authentication token")

        self.headers = {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "Authorization": auth_value,
        }
        self.project_url = f"https://dev.azure.com/{organization}/{urllib.parse.quote(project, safe='')}"

    def _request(self, url: str, data: bytes | None = None) -> dict[str, Any]:
        request = urllib.request.Request(url, headers=self.headers, data=data)
        try:
            with urllib.request.urlopen(request) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")
            raise AdoRequestError(exc.code, exc.reason, url, body) from exc

    def query_bug_ids(self, since: dt.datetime, area_path: str | None, severity: str | None) -> list[int]:
        clauses = [
            "[System.TeamProject] = @project",
            "[System.WorkItemType] = 'Bug'",
            f"[System.CreatedDate] >= '{since.date().isoformat()}'",
        ]
        if area_path:
            clauses.append(f"[System.AreaPath] UNDER '{area_path}'")
        if severity:
            clauses.append(f"[Microsoft.VSTS.Common.Severity] = '{severity}'")
        wiql = "SELECT [System.Id] FROM WorkItems WHERE " + " AND ".join(clauses)
        url = f"{self.project_url}/_apis/wit/wiql?api-version={API_VERSION}"
        payload = self._request(url, json.dumps({"query": wiql}).encode("utf-8"))
        return [item["id"] for item in payload.get("workItems", [])]

    def get_work_items(self, ids: list[int]) -> list[dict[str, Any]]:
        items: list[dict[str, Any]] = []
        for start in range(0, len(ids), BATCH_SIZE):
            batch = ids[start:start + BATCH_SIZE]
            params = {
                "ids": ",".join(str(i) for i in batch),
                "fields": ",".join(FIELDS),
                "api-version": API_VERSION,
            }
            url = f"{self.project_url}/_apis/wit/workitems?{urllib.parse.urlencode(params)}"
            payload = self._request(url)
            items.extend(payload.get("value", []))
        return items


def assigned_display(value: Any) -> str:
    if isinstance(value, dict):
        return value.get("displayName", "")
    return value or ""


def build_rows(items: list[dict[str, Any]], since: dt.datetime, project_url: str) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    for item in items:
        fields = item.get("fields", {})
        created = parse_ado_datetime(fields.get("System.CreatedDate"))
        if created is None or created < since:
            continue
        resolved = parse_ado_datetime(fields.get("Microsoft.VSTS.Common.ResolvedDate"))
        closed = parse_ado_datetime(fields.get("Microsoft.VSTS.Common.ClosedDate"))
        # Use resolved date when present, else the closed date, as the "restored" time.
        restored = resolved or closed
        rows.append(
            {
                "id": str(item.get("id", "")),
                "created_at": created.isoformat(),
                "resolved_at": restored.isoformat() if restored else "",
                "week": f"{created.isocalendar()[0]}-W{created.isocalendar()[1]:02d}",
                "state": fields.get("System.State", ""),
                "severity": fields.get("Microsoft.VSTS.Common.Severity", ""),
                "area_path": fields.get("System.AreaPath", ""),
                "title": fields.get("System.Title", ""),
                "tags": fields.get("System.Tags", "") or "",
                "assigned_to": assigned_display(fields.get("System.AssignedTo")),
                "url": (item.get("_links", {}).get("html", {}) or {}).get("href", "")
                or f"{project_url}/_workitems/edit/{item.get('id', '')}",
            }
        )
    rows.sort(key=lambda r: (r["created_at"], r["id"]))
    return rows


def write_csv(rows: list[dict[str, str]], output_path: str) -> None:
    fieldnames = [
        "id", "created_at", "resolved_at", "week", "state", "severity",
        "area_path", "title", "tags", "assigned_to", "url",
    ]
    with open(output_path, "w", newline="", encoding="utf-8") as csv_file:
        writer = csv.DictWriter(csv_file, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)


def get_azure_cli_token() -> str | None:
    try:
        result = subprocess.run(
            ["az", "account", "get-access-token", "--resource", ADO_RESOURCE,
             "--query", "accessToken", "-o", "tsv"],
            check=True, capture_output=True, text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None
    token = result.stdout.strip()
    return token or None


def main() -> int:
    parser = argparse.ArgumentParser(description="Export Azure DevOps Bug work items to CSV.")
    parser.add_argument("--organization", required=True, help="Azure DevOps organization name")
    parser.add_argument("--project", required=True, help="Azure DevOps project name")
    parser.add_argument(
        "--pat",
        default=os.environ.get("AZURE_DEVOPS_EXT_PAT") or os.environ.get("ADO_PAT"),
        help="Azure DevOps PAT. Defaults to AZURE_DEVOPS_EXT_PAT or ADO_PAT. Falls back to az login.",
    )
    parser.add_argument("--since", type=parse_date, default=parse_date(default_since()),
                        help=f"Only include bugs created on/after this date. Default: {default_since()}.")
    parser.add_argument("--area-path", help="Restrict to bugs UNDER this area path (product area).")
    parser.add_argument("--severity", help="Restrict to a single severity value (e.g. 'A' / '1 - Critical').")
    parser.add_argument("--output", default="ado_bugs.csv", help="CSV output path. Default: ado_bugs.csv")
    parser.add_argument("--verbose", action="store_true", help="Print progress to stderr")
    args = parser.parse_args()

    bearer_token = None if args.pat else get_azure_cli_token()
    if not args.pat and not bearer_token:
        print("Missing authentication. Pass --pat, set AZURE_DEVOPS_EXT_PAT/ADO_PAT, or sign in with az.", file=sys.stderr)
        return 2

    client = AzureDevOpsClient(args.organization, args.project, args.pat, bearer_token)
    ids = client.query_bug_ids(args.since, args.area_path, args.severity)
    if args.verbose:
        scope = f" under '{args.area_path}'" if args.area_path else ""
        print(f"WIQL matched {len(ids)} bug(s){scope} since {args.since.date().isoformat()}", file=sys.stderr)

    items = client.get_work_items(ids)
    rows = build_rows(items, args.since, client.project_url)
    write_csv(rows, args.output)
    print(f"Wrote {len(rows)} bug rows to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
