# DORA metrics run config (EXAMPLE / template).
#
# This file is committed with PLACEHOLDER values only. Do not put a real
# organization, project, or area path here. Instead:
#
#   1. Copy it to a local, gitignored file:
#        cp nix/bin/dora.example.env nix/bin/dora.local.env
#   2. Fill dora.local.env with your real values.
#   3. Source it and run the orchestrator:
#        set -a; source nix/bin/dora.local.env; set +a
#        ado-dora \
#          --organization "$DORA_ORG" \
#          --project "$DORA_PROJECT" \
#          --since "$DORA_SINCE" \
#          --target-branch "$DORA_TARGET_BRANCH" \
#          --prod-env "$DORA_PROD_ENV" \
#          --reliability-area-path "$DORA_RELIABILITY_AREA_PATH" \
#          --output-dir "$DORA_OUTPUT_DIR"
#
# Auth is via `az login` (default) or a PAT (AZURE_DEVOPS_EXT_PAT / ADO_PAT).

# Azure DevOps organization name (not the full URL).
DORA_ORG=my-org

# Azure DevOps project name.
DORA_PROJECT=My Project

# Window start (YYYY-MM-DD). Default in the tool is Oct 1 of last year.
DORA_SINCE=2025-01-01

# Trunk branch used for lead time + deployment counting.
DORA_TARGET_BRANCH=main

# Environment to headline for Deployment Frequency / CFR / MTTR.
# If you are not in prod yet, point this at your most prod-like env (e.g. qa).
DORA_PROD_ENV=prod

# Area path that scopes the Reliability (ADO-bug) metric. Bugs are filed per
# product area, not per repo, so use an area path such as:
#   "My Project\\My Product Area"
# Leave empty to skip the Reliability metric entirely.
DORA_RELIABILITY_AREA_PATH=My Project\\My Product Area

# Where CSVs + dora-summary.{json,md} are written.
DORA_OUTPUT_DIR=./dora-out
