#!/usr/bin/env python3
#
# opencode-cost - Per-day cost of your local opencode usage.
#
# Reads every local opencode session store (V2 opencode.db + legacy V1
# opencode-stable.db, via oc_sessions.py) and reports cost + token totals grouped by
# day. This is opencode's OWN estimate: cost = tokens x opencode's built-in
# model price table (list price). It is NOT what GitHub Copilot bills you - for
# the authoritative Copilot credits/$ figure use `copilot-usage`. The two differ
# because opencode prices at raw model list rates while Copilot meters in AI
# credits, and opencode only sees opencode sessions (not other editors).
#
# Usage:
#   opencode-cost                 # per-day, last 14 days
#   opencode-cost --days 30       # per-day, last 30 days
#   opencode-cost --month 2026-08 # a specific calendar month
#   opencode-cost --by-model      # group the window by model instead of day
#   opencode-cost --json          # raw rows as JSON
#
# Options:
#   -d, --days N     window size in days           [default: 14]
#   -m, --month YM   calendar month YYYY-MM (overrides --days)
#       --by-model   group by model, not by day
#       --json       emit JSON instead of a table
#   -h, --help       show this help
#
import argparse
import collections
import datetime as dt
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import oc_sessions as ocs  # noqa: E402


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def ms(d):
    return int(d.timestamp() * 1000)


def query(since, until, by_model, group_label):
    stores = ocs.open_stores()
    if not stores:
        die(f"no opencode session DB found in {ocs.DATA_DIR}")
    try:
        rows = ocs.sessions(stores, since, until)
    finally:
        for s in stores:
            s.close()
    agg = collections.defaultdict(lambda: [0, 0.0, 0, 0])
    for s in rows:
        key = s["model"] if by_model else \
            dt.datetime.fromtimestamp(s["updated"] / 1000).strftime("%Y-%m-%d")
        a = agg[key]
        a[0] += 1
        a[1] += s["cost"]
        a[2] += s["tokens_in"]
        a[3] += s["tokens_out"]
    return [
        {group_label: k, "sessions": v[0], "cost": round(v[1], 2),
         "tokens_in": v[2], "tokens_out": v[3]}
        for k, v in sorted(agg.items(), key=lambda kv: str(kv[0]), reverse=True)
    ]


def human(n):
    for unit in ("", "K", "M", "B"):
        if abs(n) < 1000:
            return f"{n:.0f}{unit}" if unit else f"{n:.0f}"
        n /= 1000
    return f"{n:.1f}T"


def render(rows, label):
    if not rows:
        print("no opencode sessions in that window.")
        return
    width = max(len(label), max(len(str(r[label])) for r in rows))
    hdr = f"{label:<{width}}  {'sessions':>8}  {'cost $':>10}  {'tok in':>8}  {'tok out':>8}"
    print(hdr)
    print("-" * len(hdr))
    tot_c = tot_s = tot_i = tot_o = 0
    for r in rows:
        print(f"{str(r[label]):<{width}}  {r['sessions']:>8}  {r['cost']:>10.2f}  "
              f"{human(r['tokens_in']):>8}  {human(r['tokens_out']):>8}")
        tot_c += r["cost"]; tot_s += r["sessions"]
        tot_i += r["tokens_in"]; tot_o += r["tokens_out"]
    print("-" * len(hdr))
    print(f"{'TOTAL':<{width}}  {tot_s:>8}  {tot_c:>10.2f}  "
          f"{human(tot_i):>8}  {human(tot_o):>8}")
    print()
    print("opencode list-price estimate (opencode sessions only); not the GitHub")
    print("Copilot bill - see `copilot-usage` for authoritative credits/$.")


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-d", "--days", type=int, default=14)
    p.add_argument("-m", "--month", default=None)
    p.add_argument("--by-model", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    args = p.parse_args()

    if args.help:
        with open(__file__) as fh:
            for line in fh.readlines()[2:]:
                if line.startswith("import "):
                    break
                if line.startswith("#"):
                    print(line.rstrip("\n").lstrip("#").lstrip())
        return

    if args.month:
        try:
            y, mo = (int(x) for x in args.month.split("-"))
            start = dt.datetime(y, mo, 1)
            nxt = dt.datetime(y + mo // 12, mo % 12 + 1, 1)
        except ValueError:
            die("--month must be YYYY-MM")
        since, until = ms(start), ms(nxt)
    else:
        since, until = ms(dt.datetime.now() - dt.timedelta(days=args.days)), None

    label = "model" if args.by_model else "day"
    rows = query(since, until, args.by_model, label)
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        render(rows, label)


if __name__ == "__main__":
    main()
