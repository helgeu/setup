#!/usr/bin/env bash
set -e

FAILED=0

# Get staged files (added, copied, modified — not deleted)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# nixfmt check on staged .nix files
NIX_FILES=$(echo "$STAGED" | grep '\.nix$' || true)
if [ -n "$NIX_FILES" ]; then
  echo "→ nixfmt"
  if ! echo "$NIX_FILES" | xargs /nix/store/asmrz8zq07gg333j3s83fk6ijv27yvf7-nixfmt-1.5.0/bin/nixfmt --check; then
    echo "  Fix: run 'nixfmt <file>' and re-stage"
    FAILED=1
  fi
fi

# shellcheck on staged bash scripts (.sh, .bash, and extensionless nix/bin/*)
SHELL_FILES=$(echo "$STAGED" | grep -E '(\.sh|\.bash|^nix/bin/[^/]+)$' || true)
if [ -n "$SHELL_FILES" ]; then
  echo "→ shellcheck"
  if ! echo "$SHELL_FILES" | xargs /nix/store/7i826r202acdz8c2q6hsggy44s1rkk0k-shellcheck-0.11.0-bin/bin/shellcheck --shell=bash --severity=warning; then
    echo "  Fix: address shellcheck warnings and re-stage"
    FAILED=1
  fi
fi

# gitleaks secret scanning
echo "→ gitleaks"
if ! /nix/store/bgrdsikks2p2isryllrb3hqysbbirvli-gitleaks-8.30.1/bin/gitleaks protect --staged --no-banner; then
  echo "  Secrets detected in staged changes. Commit blocked."
  FAILED=1
fi

if [ $FAILED -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit checks failed. Fix issues above and re-stage."
  exit 1
fi

echo "✓ All checks passed"
